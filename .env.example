# Скопируйте в .env: cp .env.example .env
# Файл .env не коммитится. Значения ниже — заглушки для локальной разработки,
# в production задайте свои.

# --- База данных ---
# Пользователь, пароль и имя базы PostgreSQL (контейнер postgres в Docker Compose)
POSTGRES_USER=smk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smk
# Подключение CMS к базе с хоста. Внутри Docker Compose хост заменяется на postgres.
# Тесты берут эту же базу, e2e — базу с суффиксом _e2e.
DATABASE_URL=postgres://smk:change-me@localhost:5432/smk

# --- Payload (apps/cms) ---
# Ключ шифрования сессий и токенов. В production — длинная случайная строка:
# openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Публичный адрес CMS: админка и ссылки на файлы
CMS_PUBLIC_URL=http://localhost:3000

# --- Сайт (apps/site) ---
# Адрес CMS для запросов с сервера сайта. Внутри Docker Compose — http://cms:3000
CMS_API_URL=http://localhost:3000
# Публичный адрес сайта. CMS разрешает с него запросы (CORS, CSRF).
SITE_URL=http://localhost:4321

# --- Уведомления о заявках (понадобятся в изменении с формой заявки) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
LEADS_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
